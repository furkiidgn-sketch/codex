rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid in request.resource.data.players.keys();
    }
    match /leaderboard/{period}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /soloResults/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
